<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>이예찬 | About Me</title>

  <!-- 귀여운 폰트 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jua&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">

  <style>
    /* =========================
       기본 설정
    ========================= */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      scroll-behavior: smooth;
    }

    :root {
      --blue: #1769aa;
      --dark-blue: #103b66;
      --light-blue: #eaf5ff;

      --yellow: #ffd34e;
      --light-yellow: #fff6c9;

      --autumn: #c86b32;
      --light-autumn: #f3d0ad;

      --cream: #fffaf2;
      --brown: #6b4733;

      --text: #263746;
      --white: #ffffff;

      --shadow: 0 15px 35px rgba(25, 55, 80, 0.12);
      --radius: 25px;
    }

    body {
      font-family: "Nunito", "Apple SD Gothic Neo", sans-serif;
      color: var(--text);
      line-height: 1.7;

      background:
        radial-gradient(
          circle at 10% 5%,
          rgba(255, 211, 78, 0.25),
          transparent 25%
        ),
        radial-gradient(
          circle at 90% 30%,
          rgba(200, 107, 50, 0.15),
          transparent 25%
        ),
        var(--cream);
    }

    h1,
    h2,
    h3,
    .logo {
      font-family: "Jua", sans-serif;
    }

    a {
      text-decoration: none;
      color: inherit;
    }


    /* =========================
       네비게이션
    ========================= */

    nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;

      background: rgba(255, 250, 242, 0.9);
      backdrop-filter: blur(15px);

      border-bottom: 1px solid rgba(23, 105, 170, 0.1);
    }

    .nav-inner {
      max-width: 1100px;
      margin: auto;

      padding: 14px 20px;

      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 25px;
      color: var(--dark-blue);
    }

    .logo span {
      color: var(--autumn);
    }

    .nav-links {
      display: flex;
      gap: 8px;
    }

    .nav-links a {
      padding: 8px 14px;
      border-radius: 30px;

      font-weight: 800;
      font-size: 14px;

      transition: 0.2s;
    }

    .nav-links a:hover {
      background: var(--light-blue);
      color: var(--blue);
    }

    .menu-btn {
      display: none;

      border: none;
      background: var(--blue);
      color: white;

      border-radius: 12px;
      padding: 7px 11px;

      cursor: pointer;
      font-size: 18px;
    }


    /* =========================
       HERO
    ========================= */

    .hero {
      min-height: 720px;

      padding: 140px 20px 90px;

      display: flex;
      align-items: center;

      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: "";

      position: absolute;
      width: 430px;
      height: 430px;

      background: var(--light-blue);

      border-radius: 50%;

      right: -120px;
      top: 70px;

      z-index: -1;
    }

    .hero::after {
      content: "";

      position: absolute;

      width: 260px;
      height: 260px;

      background: var(--light-yellow);

      border-radius: 50%;

      left: -90px;
      bottom: 10px;

      z-index: -1;
    }

    .hero-inner {
      width: 100%;
      max-width: 1100px;

      margin: auto;

      display: grid;
      grid-template-columns: 1.1fr 0.9fr;

      gap: 55px;

      align-items: center;
    }

    .eyebrow {
      display: inline-flex;

      align-items: center;
      gap: 7px;

      padding: 7px 14px;

      border-radius: 30px;

      background: var(--light-yellow);

      color: var(--brown);

      font-size: 14px;
      font-weight: 800;
    }

    .hero h1 {
      font-size: clamp(55px, 8vw, 88px);

      line-height: 1.05;

      margin: 20px 0 15px;

      color: var(--dark-blue);
    }

    .hero h1 span {
      color: var(--autumn);
    }

    .hero-sub {
      max-width: 580px;

      font-size: 19px;

      font-weight: 700;

      color: #526574;
    }

    .chips {
      display: flex;

      flex-wrap: wrap;

      gap: 9px;

      margin: 23px 0;
    }

    .chip {
      padding: 7px 13px;

      border-radius: 20px;

      background: white;

      border: 1px solid #e7dfd4;

      font-size: 14px;

      font-weight: 800;
    }

    .cta {
      display: inline-flex;

      align-items: center;
      gap: 8px;

      background: var(--blue);

      color: white;

      padding: 12px 20px;

      border-radius: 16px;

      font-weight: 800;

      box-shadow: 0 8px 18px rgba(23, 105, 170, 0.22);

      transition: 0.2s;
    }

    .cta:hover {
      transform: translateY(-3px);

      background: var(--dark-blue);
    }


    /* =========================
       프로필 카드
    ========================= */

    .profile-card {
      background: rgba(255, 255, 255, 0.9);

      padding: 18px;

      border-radius: 32px;

      box-shadow: var(--shadow);

      transform: rotate(2deg);
    }

    .profile-photo {
      height: 410px;

      border-radius: 24px;

      background:
        linear-gradient(
          180deg,
          rgba(23, 105, 170, 0.03),
          rgba(200, 107, 50, 0.15)
        ),
        url("https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=1000&q=85")
        center / cover;

      position: relative;

      overflow: hidden;
    }

    .photo-note {
      position: absolute;

      left: 18px;
      bottom: 18px;

      background: rgba(255, 255, 255, 0.92);

      padding: 11px 14px;

      border-radius: 16px;

      font-weight: 800;

      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
    }


    /* =========================
       공통 SECTION
    ========================= */

    section {
      padding: 90px 20px;
    }

    .section-inner {
      max-width: 1100px;
      margin: auto;
    }

    .section-title {
      margin-bottom: 10px;

      color: var(--dark-blue);

      font-size: 40px;
    }

    .section-lead {
      margin-bottom: 32px;

      color: #657583;
    }


    /* =========================
       ABOUT
    ========================= */

    .about-grid {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 22px;
    }

    .card {
      background: white;

      border: 1px solid #eee5d9;

      border-radius: var(--radius);

      padding: 27px;

      box-shadow: 0 8px 25px rgba(25, 55, 80, 0.06);
    }

    .about-main {
      background:
        linear-gradient(
          135deg,
          #ffffff,
          #eef8ff
        );
    }

    .quote {
      font-family: "Jua", sans-serif;

      font-size: 26px;

      color: var(--dark-blue);

      margin: 12px 0 18px;
    }

    .personality-list {
      display: grid;

      gap: 14px;

      margin-top: 18px;
    }

    .personality-item {
      display: flex;

      gap: 11px;

      align-items: flex-start;
    }

    .personality-item b {
      display: block;

      color: var(--dark-blue);
    }

    .emoji-box {
      width: 40px;
      height: 40px;

      flex: 0 0 40px;

      border-radius: 12px;

      background: var(--light-yellow);

      display: grid;
      place-items: center;

      font-size: 21px;
    }


    /* =========================
       좋아하는 것
    ========================= */

    .favorites {
      background:
        linear-gradient(
          180deg,
          rgba(255, 211, 78, 0.09),
          rgba(200, 107, 50, 0.08)
        );
    }

    .fav-grid {
      display: grid;

      grid-template-columns: repeat(4, 1fr);

      gap: 16px;
    }

    .fav {
      min-height: 190px;

      border-radius: 23px;

      padding: 22px;

      position: relative;

      overflow: hidden;

      box-shadow: var(--shadow);

      transition: 0.25s;
    }

    .fav:hover {
      transform: translateY(-7px);
    }

    .fav:nth-child(1) {
      background: linear-gradient(
        145deg,
        #1769aa,
        #3e91c8
      );

      color: white;
    }

    .fav:nth-child(2) {
      background: linear-gradient(
        145deg,
        #e5ad22,
        #ffd95e
      );

      color: #5a4510;
    }

    .fav:nth-child(3) {
      background: linear-gradient(
        145deg,
        #c15e2e,
        #e49a59
      );

      color: white;
    }

    .fav:nth-child(4) {
      background: linear-gradient(
        145deg,
        #568b55,
        #9bbb71
      );

      color: white;
    }

    .fav .big {
      font-size: 40px;
    }

    .fav h3 {
      font-size: 22px;

      margin: 8px 0 3px;
    }

    .fav p {
      font-size: 14px;

      margin: 0;

      opacity: 0.9;
    }


    /* =========================
       야구
    ========================= */

    .baseball {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 25px;
    }

    .baseball-photo {
      min-height: 370px;

      border-radius: var(--radius);

      background:
        linear-gradient(
          180deg,
          rgba(16, 59, 102, 0.04),
          rgba(16, 59, 102, 0.4)
        ),
        url("https://images.unsplash.com/photo-1566577739112-5180d4bf9390?auto=format&fit=crop&w=1200&q=85")
        center / cover;

      box-shadow: var(--shadow);

      position: relative;
    }

    .baseball-photo span {
      position: absolute;

      left: 20px;
      bottom: 20px;

      background: rgba(255, 255, 255, 0.92);

      border-radius: 15px;

      padding: 10px 14px;

      font-weight: 800;

      color: var(--dark-blue);
    }

    .eagles {
      background:
        linear-gradient(
          145deg,
          #ffffff,
          #fff6df
        );

      border: 2px solid var(--yellow);
    }

    .scoreboard {
      display: flex;

      gap: 10px;

      margin: 20px 0;
    }

    .score {
      flex: 1;

      text-align: center;

      background: #f5f9fc;

      border-radius: 16px;

      padding: 15px;
    }

    .score strong {
      display: block;

      font-family: "Jua", sans-serif;

      font-size: 25px;

      color: var(--blue);
    }

    .score small {
      color: #71808d;
    }


    /* =========================
       MY STORY
    ========================= */

    .timeline {
      position: relative;

      display: grid;

      gap: 16px;
    }

    .timeline::before {
      content: "";

      position: absolute;

      left: 17px;

      top: 0;
      bottom: 0;

      width: 3px;

      background: var(--light-autumn);
    }

    .time-item {
      position: relative;

      padding-left: 52px;
    }

    .dot {
      position: absolute;

      left: 7px;
      top: 6px;

      width: 23px;
      height: 23px;

      border-radius: 50%;

      background: var(--yellow);

      border: 5px solid var(--cream);
    }

    .time-item h3 {
      color: var(--dark-blue);

      font-size: 20px;
    }

    .time-item p {
      color: #667683;
    }


    /* =========================
       INTERACTION
    ========================= */

    .interaction {
      margin-top: 25px;

      text-align: center;

      background: var(--dark-blue);

      color: white;

      border-radius: 32px;

      padding: 45px 25px;

      overflow: hidden;
    }

    .interaction h2 {
      color: white;

      margin-bottom: 8px;
    }

    .mood {
      border: none;

      border-radius: 18px;

      background: var(--yellow);

      color: #4d3c0e;

      padding: 12px 19px;

      font-weight: 800;

      cursor: pointer;

      transition: 0.2s;

      margin-top: 15px;
    }

    .mood:hover {
      transform: scale(1.05);
    }

    #message {
      margin-top: 17px;

      min-height: 30px;

      color: #eaf6ff;

      font-weight: 700;
    }


    /* =========================
       FOOTER
    ========================= */

    footer {
      padding: 35px 20px;

      text-align: center;

      background: #0c2e4d;

      color: #d9eaf6;
    }

    footer b {
      color: white;
    }

    footer small {
      display: block;

      margin-top: 6px;

      opacity: 0.75;
    }


    /* =========================
       태블릿 / 모바일
    ========================= */

    @media (max-width: 800px) {

      .nav-links {
        display: none;

        position: absolute;

        top: 65px;

        left: 15px;
        right: 15px;

        background: white;

        border-radius: 18px;

        padding: 10px;

        box-shadow: var(--shadow);

        flex-direction: column;
      }

      .nav-links.open {
        display: flex;
      }

      .menu-btn {
        display: block;
      }

      .hero {
        padding-top: 115px;
      }

      .hero-inner {
        grid-template-columns: 1fr;

        gap: 40px;
      }

      .profile-card {
        transform: none;

        max-width: 520px;

        width: 100%;

        margin: auto;
      }

      .about-grid {
        grid-template-columns: 1fr;
      }

      .baseball {
        grid-template-columns: 1fr;
      }

      .fav-grid {
        grid-template-columns: 1fr 1fr;
      }

      .profile-photo {
        height: 330px;
      }
    }


    @media (max-width: 480px) {

      section {
        padding: 70px 18px;
      }

      .hero h1 {
        font-size: 55px;
      }

      .hero-sub {
        font-size: 16px;
      }

      .section-title {
        font-size: 32px;
      }

      .fav-grid {
        grid-template-columns: 1fr;
      }

      .fav {
        min-height: 150px;
      }

      .profile-photo {
        height: 280px;
      }

      .scoreboard {
        flex-direction: column;
      }
    }
  </style>
</head>


